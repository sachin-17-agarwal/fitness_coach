<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Re-sign of Vaux on the phone, so the free provisioning profile never runs
  out. Fires at 07:30 and 21:00 every day; the script itself decides whether
  a re-sign is due (three days since the last good one) and exits at once
  otherwise. So a phone that is out at 21:00 Sunday and home at 07:30 Monday
  is re-signed Monday morning, and a phone that is home every evening is
  re-signed about twice a week and left alone in between.

  Install (once):
    cp tools/com.vaux.deploy.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.vaux.deploy.plist

  Run it now to test:
    launchctl kickstart -k gui/$(id -u)/com.vaux.deploy

  Remove:
    launchctl bootout gui/$(id -u)/com.vaux.deploy

  Log: ~/Library/Logs/vaux-deploy.log

  The Mac has to be awake for a slot to fire; a slot missed while asleep
  runs when the Mac next wakes, and a slot that finds no phone just tries
  again at the next one.
-->
<dict>
    <key>Label</key>
    <string>com.vaux.deploy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/sachin/Documents/GitHub/fitness_coach/tools/deploy_device.sh</string>
        <string>--only-if-due</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sachin/Documents/GitHub/fitness_coach</string>

    <!-- xcodebuild and devicectl live under the active Xcode; launchd's
         default PATH does not include them. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
        <key>DEVELOPER_DIR</key>
        <string>/Applications/Xcode.app/Contents/Developer</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>21</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/sachin/Library/Logs/vaux-deploy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sachin/Library/Logs/vaux-deploy.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
