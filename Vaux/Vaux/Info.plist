<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict/>
	</array>
	<key>CFBundleGetInfoString</key>
	<string></string>
	<key>CFBundleSignature</key>
	<string></string>
	<!-- Required for the rest-timer Live Activity. Without this the app
	     builds and runs, but Activity.request throws every time and the
	     Dynamic Island stays empty. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Lets the rest countdown keep updating while the phone is locked. -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict/>
	</array>
</dict>
</plist>
