<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict/>
	</array>
	<key>CFBundleGetInfoString</key>
	<string></string>
	<key>CFBundleSignature</key>
	<string></string>
	<!-- Anton (SIL OFL, Resources/Anton-OFL.txt) — the display face for the
	     rest screen's poster numerals. Falls back to SF Compressed Black in
	     code if the font fails to register, so a bad path here degrades the
	     look, never the screen. -->
	<key>UIAppFonts</key>
	<array>
		<string>Anton-Regular.ttf</string>
	</array>
	<!-- NSSupportsLiveActivities and its FrequentUpdates companion are set
	     as INFOPLIST_KEY_ build settings on the Vaux target, not here. Declared
	     in this file they did not reach the installed bundle: the iPhone's
	     Settings page for Vaux showed no Live Activities toggle, and
	     ActivityKit refuses every request from an app that does not declare
	     support. Generated keys are written straight into the bundle's plist. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict/>
	</array>
</dict>
</plist>
